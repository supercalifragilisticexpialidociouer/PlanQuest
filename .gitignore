# 依赖（458MB，绝不上传）
node_modules/
**/node_modules/

# 发布产物（>100MB，走 Releases，不进仓库）
dist/PlanQuest-win64-portable.zip
dist/releases/*.exe
dist/PlanQuest-win64/PlanQuest.exe

# -electron 运行时缓存 / 临时
*.log
.DS_Store
thumbs.db
.trash-docs/
.workbuddy/

# 截图与临时产物（可选保留，体积不大就不排）
# shots/

# 大体积 vendor 二进制（模型/语音包/wasm/视频）走 Releases，不进仓库
web/vendor/**/*.onnx
web/vendor/**/*.wasm
web/vendor/**/*.zip
src/renderer/vendor/
**/assets/*.mp4
tools/Output/
